# --- Local development -------------------------------------------------------
# Postgres provided by `pnpm prisma dev` (see README). For production these two
# are replaced by the Neon connection string.
DATABASE_URL=""
SHADOW_DATABASE_URL=""

AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# --- OAuth -------------------------------------------------------------------
# Fill these in from Google Cloud Console and GitHub Developer Settings.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Offers a one-click local sign-in so the app is usable before OAuth is set up.
# Never set this in production.
DEV_LOGIN="false"
